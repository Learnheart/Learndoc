{
  "$id": "https://learndoc.local/schemas/answer.schema.json",
  "title": "Ask-mode answer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "answer",
    "sources"
  ],
  "properties": {
    "answer": {
      "type": "string",
      "description": "Whitelisted HTML with $…$ / $$…$$ math."
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*#(p[0-9]+(-[0-9]+)?|[a-z0-9][a-z0-9-]*)(\\|.{1,80})?$"
      }
    }
  }
}
