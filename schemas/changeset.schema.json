{
  "$id": "https://learndoc.local/schemas/changeset.schema.json",
  "title": "Changeset",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "op",
          "role"
        ],
        "properties": {
          "op": {
            "enum": [
              "replace",
              "insert",
              "delete",
              "move"
            ]
          },
          "blockId": {
            "$ref": "#/$defs/blockId"
          },
          "after": {
            "anyOf": [
              {
                "$ref": "#/$defs/blockId"
              },
              {
                "type": "null"
              }
            ]
          },
          "role": {
            "enum": [
              "primary",
              "related"
            ]
          },
          "group": {
            "type": "string"
          },
          "block": {
            "anyOf": [
              {
                "$ref": "#/$defs/heading"
              },
              {
                "$ref": "#/$defs/prose"
              },
              {
                "$ref": "#/$defs/box"
              },
              {
                "$ref": "#/$defs/math"
              },
              {
                "$ref": "#/$defs/code"
              },
              {
                "$ref": "#/$defs/figure"
              },
              {
                "$ref": "#/$defs/widget"
              },
              {
                "$ref": "#/$defs/quiz"
              }
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "notation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "set": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "remove": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "needsConfirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "reason"
      ],
      "properties": {
        "scope": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/blockId"
          }
        },
        "reason": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "blockId": {
      "type": "string",
      "pattern": "^b-[a-z0-9]{4,12}$"
    },
    "sourceRef": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*#(p[0-9]+(-[0-9]+)?|[a-z0-9][a-z0-9-]*)(\\|.{1,80})?$"
    },
    "heading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "level",
        "anchor",
        "text"
      ],
      "properties": {
        "type": {
          "const": "heading"
        },
        "level": {
          "enum": [
            2,
            3
          ]
        },
        "anchor": {
          "$ref": "#/$defs/slug"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "prose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "html",
        "sources"
      ],
      "properties": {
        "type": {
          "const": "prose"
        },
        "html": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        }
      }
    },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "variant",
        "title",
        "html",
        "sources"
      ],
      "properties": {
        "type": {
          "const": "box"
        },
        "variant": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "html": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        }
      }
    },
    "math": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "latex",
        "sources"
      ],
      "properties": {
        "type": {
          "const": "math"
        },
        "latex": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        }
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "language",
        "code"
      ],
      "properties": {
        "type": {
          "const": "code"
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9+#._-]{0,31}$"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "caption": {
          "type": "string"
        }
      }
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "alt",
        "caption"
      ],
      "properties": {
        "type": {
          "const": "figure"
        },
        "svg": {
          "type": "string",
          "pattern": "^\\s*<svg[\\s>]"
        },
        "src": {
          "type": "string",
          "pattern": "^assets/[A-Za-z0-9_][A-Za-z0-9._-]*(/[A-Za-z0-9_][A-Za-z0-9._-]*)*$"
        },
        "alt": {
          "type": "string",
          "minLength": 1
        },
        "caption": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "widget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "widget",
        "props"
      ],
      "properties": {
        "type": {
          "const": "widget"
        },
        "widget": {
          "$ref": "#/$defs/slug"
        },
        "props": {
          "type": "object"
        }
      }
    },
    "quiz": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "question",
        "answer",
        "sources"
      ],
      "properties": {
        "type": {
          "const": "quiz"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        }
      }
    }
  }
}
