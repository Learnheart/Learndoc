{
  "name": "learndoc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive, editable learning documents rendered from typed lesson JSON.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate:validators": "node scripts/generate-validators.mjs",
    "check:validators": "node scripts/generate-validators.mjs --check",
    "vendor": "node scripts/vendor-katex.mjs && node scripts/vendor-pdfjs.mjs",
    "test": "node --test --test-timeout=120000 test/unit/*.test.mjs"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "katex": "^0.16.47",
    "pdfjs-dist": "^6.1.200"
  },
  "overrides": {
    "commander": "8.3.0",
    "fast-uri": "3.1.4"
  }
}
